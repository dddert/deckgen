# Скопируйте в .env (docker compose) или экспортируйте перед запуском. Остальное — config.yaml.
# --- инференс (vLLM на этой машине; для топ-10 — адрес/ключ инференса VK)
LLM_BASE_URL=http://127.0.0.1:18000/v1
LLM_API_KEY=none
LLM_SERVED_NAME=qwen
VLM_BASE_URL=http://127.0.0.1:18000/v1
VLM_API_KEY=none
VLM_SERVED_NAME=qwen
# LLM_PROVIDER=offline        # без модели: эвристический планировщик/писатель (демо, тесты, отказ сервера)
# --- модель для vLLM (RTX A6000 48 ГБ): см. MODELS.md
LLM_MODEL=Qwen/Qwen3.8-27B-FP8
LLM_MAX_LEN=32768
LLM_MAX_SEQS=16
VLLM_GPU_UTIL=0.88
VLLM_MTP=0
GPU_ID=0
HF_TOKEN=
# --- text-to-image (⭐): FLUX.2-klein-4B рядом с vLLM -> VLLM_GPU_UTIL=0.72
T2I_ENABLED=false
# --- рендер и пути
SOFFICE_BIN=soffice
PDF_BACKEND=auto
DECKGEN_OUTPUTS=./data/outputs
API_HOST=127.0.0.1
API_PORT=18080
